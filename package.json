{
  "name": "latte-mouse-game",
  "version": "1.0.0",
  "private": true,
  "description": "Node.jsとPostgreSQLを段階的に学ぶブラウザゲーム",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/database-config.test.js tests/static-assets.test.js tests/stage3.test.js tests/stage4-browser.test.js tests/stage5.test.js",
    "start": "node --env-file-if-exists=.env scripts/server.js",
    "db:setup": "node scripts/database.js setup",
    "db:api-setup": "node scripts/database.js api-setup",
    "db:auth-setup": "node scripts/database.js auth-setup",
    "db:start": "node scripts/database.js start",
    "db:stop": "node scripts/database.js stop",
    "db:status": "node scripts/database.js status",
    "db:shell": "node scripts/database.js shell",
    "db:practice": "node scripts/database.js practice",
    "db:backup": "node scripts/backup-game-data.js",
    "db:restore-check": "node scripts/restore-game-data.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
