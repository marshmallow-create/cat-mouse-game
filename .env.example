# 接続情報はサーバーだけが使用します。実際の値は.envに保存します。
# 準備中はlocal。移行・確認後にsupabaseへ変更してください。
DATABASE_MODE=local
# SupabaseのConnect > Session poolerから取得する接続URL。
# ゲーム専用DBロールlatte_appを作成後、その認証情報を使用します。
# DATABASE_URL=postgresql://latte_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# 証明書が必要な接続では、Dashboardから取得したCAファイルを指定。
# DATABASE_SSL_CA_FILE=.local/supabase-ca.crt

# 公開環境（ローカルでは設定不要）
# NODE_ENV=production
# APP_ORIGIN=https://YOUR-SERVICE.onrender.com
# Renderでは未指定時にRENDER_EXTERNAL_URLを使用します。
# HOST=0.0.0.0
# DATABASE_SSL_CAにはCA証明書のPEM内容を設定できます。
